{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pk:minun",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pk:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.55 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["glow_berries", "apple"],
          "grow_up": { "event": "minecraft:ageable_grow_up", "target": "self" }
        }
      },

      "pk:adult": {
        "minecraft:scale": { "value": 1.0 }
      },

      "pk:wild": {
        "minecraft:despawn": { "despawn_from_distance": {} },
        "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.7 },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 3,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 8,
              "walk_speed_multiplier": 1.5,
              "sprint_speed_multiplier": 1.7
            }
          ]
        },
        "minecraft:behavior.tempt": {
          "priority": 5,
          "speed_multiplier": 1.1,
          "items": ["glow_berries"]
        }
      },

      "pk:tame": {
        "minecraft:is_tamed": {},
        "minecraft:health": { "value": 28, "max": 28 },
        "minecraft:attack": { "damage": 3 },
        "minecraft:sittable": {},
        "minecraft:healable": {
          "filters": { "test": "is_owner", "subject": "other" },
          "items": [
            { "item": "glow_berries", "heal_amount": 4 },
            { "item": "apple", "heal_amount": 6 }
          ]
        },
        "minecraft:breedable": {
          "require_tame": true,
          "breed_items": ["apple", "glow_berries"],
          "breeds_with": [
            {
              "mate_type": "pk:minun",
              "baby_type": "pk:minun",
              "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
            }
          ]
        },
        "minecraft:mob_effect": {
          "mob_effect": "speed",
          "effect_range": 6.0,
          "effect_time": 8,
          "cooldown_time": 5,
          "entity_filter": {
            "all_of": [
              { "test": "is_family", "subject": "other", "value": "player" },
              { "test": "is_owner", "subject": "other" }
            ]
          }
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.stay_while_sitting": { "priority": 3 },
        "minecraft:behavior.breed": { "priority": 5, "speed_multiplier": 1.0 },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.3,
          "start_distance": 8,
          "stop_distance": 2
        }
      },

      "pk:sheltering": {
        "minecraft:type_family": { "family": ["minun", "wet", "mob"] },
        "minecraft:movement": { "value": 0.4 },
        "minecraft:behavior.move_to_land": {
          "priority": 1,
          "search_range": 16,
          "search_height": 5,
          "goal_radius": 0.9,
          "speed_multiplier": 1.6
        },
        "minecraft:behavior.flee_sun": { "priority": 2, "speed_multiplier": 1.5 },
        "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 1.5 }
      },

      "pk:caught": {
        "minecraft:transformation": {
          "into": "pk:caught_minun",
          "delay": { "value": 0.35 },
          "keep_owner": true,
          "drop_equipment": false,
          "transformation_sound": "beacon.deactivate"
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["minun", "mob"] },
      "minecraft:collision_box": { "width": 0.7, "height": 0.95 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:attack": { "damage": 2 },
      "minecraft:movement": { "value": 0.33 },
      "minecraft:follow_range": { "value": 24, "max": 24 },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": {},
      "minecraft:leashable": { "soft_distance": 4, "hard_distance": 6, "max_distance": 10 },
      "minecraft:loot": { "table": "loot_tables/entities/minun.json" },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,4) : 0"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "projectile",
            "deals_damage": false,
            "on_damage": {
              "event": "pk:on_captured",
              "target": "self",
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "damager", "value": "poke_ball" },
                  { "test": "is_family", "subject": "other", "value": "poke_ball" }
                ]
              }
            }
          },
          {
            "cause": "projectile",
            "deals_damage": "no",
            "damage_multiplier": 0,
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "damager", "value": "electric_move" },
                { "test": "is_family", "subject": "other", "value": "electric_move" }
              ]
            }
          },
          { "cause": "lightning", "deals_damage": "no", "damage_multiplier": 0 },
          { "cause": "magic", "damage_multiplier": 0.7 },
          { "cause": "projectile", "damage_multiplier": 0.7 }
        ]
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "in_water_or_rain", "subject": "self",
                  "operator": "==", "value": true
                },
                {
                  "test": "is_family", "subject": "self",
                  "operator": "!=", "value": "wet"
                }
              ]
            },
            "event": "pk:take_cover"
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "in_water_or_rain", "subject": "self",
                  "operator": "==", "value": false
                },
                { "test": "is_family", "subject": "self", "value": "wet" }
              ]
            },
            "event": "pk:dried_off"
          }
        ]
      },
      "minecraft:tameable": {
        "probability": 0.3,
        "tame_items": ["glow_berries"],
        "tame_event": { "event": "pk:on_tame", "target": "self" }
      },
      "minecraft:shooter": { "def": "pk:minus_spark" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 2 },
      "minecraft:behavior.ranged_attack": {
        "priority": 4,
        "attack_interval_min": 1.2,
        "attack_interval_max": 2.6,
        "burst_shots": 1,
        "attack_radius": 12,
        "charge_shoot_trigger": 0
      },
      "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 1.0 },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 8,
        "probability": 0.03
      },
      "minecraft:behavior.random_look_around": { "priority": 10 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          { "add": { "component_groups": ["pk:wild"] } },
          {
            "randomize": [
              { "weight": 90, "add": { "component_groups": ["pk:adult"] } },
              { "weight": 10, "add": { "component_groups": ["pk:baby"] } }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "add": { "component_groups": ["pk:tame", "pk:baby"] }
      },
      "minecraft:ageable_grow_up": {
        "remove": { "component_groups": ["pk:baby"] },
        "add": { "component_groups": ["pk:adult"] }
      },
      "pk:on_tame": {
        "remove": { "component_groups": ["pk:wild"] },
        "add": { "component_groups": ["pk:tame"] }
      },
      "pk:take_cover": {
        "add": { "component_groups": ["pk:sheltering"] }
      },
      "pk:dried_off": {
        "remove": { "component_groups": ["pk:sheltering"] }
      },
      "pk:on_captured": {
        "sequence": [
          {
            "filters": { "test": "has_component", "subject": "self", "value": "minecraft:is_tamed" },
            "add": { "component_groups": ["pk:caught"] }
          },
          {
            "filters": {
              "test": "has_component", "subject": "self",
              "operator": "!=", "value": "minecraft:is_tamed"
            },
            "randomize": [
              { "weight": 13, "add": { "component_groups": ["pk:caught"] } },
              { "weight": 7, "trigger": "pk:break_free" }
            ]
          }
        ]
      },
      "pk:break_free": {
        "add": { "component_groups": ["pk:wild"] }
      },
      "minecraft:entity_transformed": {
        "add": { "component_groups": ["pk:adult", "pk:tame"] }
      }
    }
  }
}
