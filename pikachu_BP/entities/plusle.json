{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pk:plusle",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pk:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.55 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["redstone", "glow_berries"],
          "grow_up": { "event": "minecraft:ageable_grow_up", "target": "self" }
        }
      },

      "pk:adult": {
        "minecraft:scale": { "value": 1.0 }
      },

      "pk:wild": {
        "minecraft:despawn": { "despawn_from_distance": {} },
        "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.7 },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 3,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 8,
              "walk_speed_multiplier": 1.4,
              "sprint_speed_multiplier": 1.7
            }
          ]
        },
        "minecraft:behavior.tempt": {
          "priority": 5,
          "speed_multiplier": 1.2,
          "items": ["redstone"]
        }
      },

      "pk:tame": {
        "minecraft:is_tamed": {},
        "minecraft:health": { "value": 30, "max": 30 },
        "minecraft:attack": { "damage": 4 },
        "minecraft:sittable": {},
        "minecraft:healable": {
          "filters": { "test": "is_owner", "subject": "other" },
          "items": [
            { "item": "redstone", "heal_amount": 4 },
            { "item": "glow_berries", "heal_amount": 6 }
          ]
        },
        "minecraft:breedable": {
          "require_tame": true,
          "breed_items": ["glow_berries", "sweet_berries"],
          "breeds_with": [
            {
              "mate_type": "pk:plusle",
              "baby_type": "pk:plusle",
              "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
            }
          ]
        },
        "minecraft:mob_effect": {
          "mob_effect": "strength",
          "effect_range": 6.0,
          "effect_time": 8,
          "cooldown_time": 6,
          "entity_filter": {
            "all_of": [
              { "test": "is_family", "subject": "other", "value": "player" },
              { "test": "is_owner", "subject": "other" }
            ]
          }
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.stay_while_sitting": { "priority": 3 },
        "minecraft:behavior.breed": { "priority": 5, "speed_multiplier": 1.0 },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.4,
          "start_distance": 8,
          "stop_distance": 2,
          "can_teleport": true
        }
      },

      "pk:plus": {
        "minecraft:type_family": { "family": ["plusle", "electric", "cheering", "mob"] },
        "minecraft:variant": { "value": 1 },
        "minecraft:shooter": { "def": "pk:spark_plus" },
        "minecraft:movement": { "value": 0.42 },
        "minecraft:timer": {
          "looping": false,
          "time": 12.0,
          "time_down_event": { "event": "pk:plus_off" }
        }
      },

      "pk:charged": {
        "minecraft:type_family": { "family": ["plusle", "electric", "cheering", "mob"] },
        "minecraft:variant": { "value": 1 },
        "minecraft:shooter": { "def": "pk:spark_plus" },
        "minecraft:attack": { "damage": 6 },
        "minecraft:timer": {
          "looping": false,
          "time": 45.0,
          "time_down_event": { "event": "pk:discharge" }
        }
      },

      "pk:caught": {
        "minecraft:transformation": {
          "into": "pk:caught_plusle",
          "delay": { "value": 0.35 },
          "keep_owner": true,
          "drop_equipment": false,
          "transformation_sound": "beacon.deactivate"
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["plusle", "electric", "mob"] },
      "minecraft:collision_box": { "width": 0.7, "height": 0.95 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:attack": { "damage": 2 },
      "minecraft:movement": { "value": 0.34 },
      "minecraft:follow_range": { "value": 24, "max": 24 },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": {},
      "minecraft:leashable": { "soft_distance": 4, "hard_distance": 6, "max_distance": 10 },
      "minecraft:loot": { "table": "loot_tables/entities/plusle.json" },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,4) : 0"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "projectile",
            "deals_damage": false,
            "on_damage": {
              "event": "pk:on_captured",
              "target": "self",
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "damager", "value": "poke_ball" },
                  { "test": "is_family", "subject": "other", "value": "poke_ball" }
                ]
              }
            }
          },
          {
            "cause": "projectile",
            "deals_damage": "no",
            "damage_multiplier": 0,
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "damager", "value": "electric_move" },
                { "test": "is_family", "subject": "other", "value": "electric_move" }
              ]
            }
          },
          {
            "cause": "lightning",
            "deals_damage": "no",
            "damage_multiplier": 0,
            "on_damage": { "event": "pk:charge_up", "target": "self" }
          },
          { "cause": "fall", "damage_multiplier": 2.0 }
        ]
      },
      "minecraft:tameable": {
        "probability": 0.3,
        "tame_items": ["redstone"],
        "tame_event": { "event": "pk:on_tame", "target": "self" }
      },
      "minecraft:shooter": { "def": "pk:spark" },
      "minecraft:entity_sensor": {
        "relative_range": false,
        "subsensors": [
          {
            "range": [6, 4],
            "minimum_count": 1,
            "cooldown": 0.5,
            "event": "pk:plus_on",
            "event_filters": {
              "all_of": [
                {
                  "any_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "is_family", "subject": "other", "value": "minun" }
                  ]
                },
                {
                  "test": "is_family", "subject": "self",
                  "operator": "!=", "value": "cheering"
                }
              ]
            }
          },
          {
            "range": [8, 5],
            "minimum_count": 0,
            "maximum_count": 0,
            "cooldown": 1.0,
            "event": "pk:plus_off",
            "event_filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "minun" }
              ]
            }
          }
        ]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 2 },
      "minecraft:behavior.ranged_attack": {
        "priority": 4,
        "attack_interval_min": 1.2,
        "attack_interval_max": 2.4,
        "burst_shots": 1,
        "attack_radius": 12,
        "attack_radius_min": 3,
        "charge_shoot_trigger": 0
      },
      "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 1.0 },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 8,
        "probability": 0.04
      },
      "minecraft:behavior.random_look_around": { "priority": 10 },
      "minecraft:conditional_bandwidth_optimization": {}
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          { "add": { "component_groups": ["pk:wild"] } },
          {
            "randomize": [
              { "weight": 90, "add": { "component_groups": ["pk:adult"] } },
              { "weight": 10, "add": { "component_groups": ["pk:baby"] } }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "add": { "component_groups": ["pk:tame", "pk:baby"] }
      },
      "minecraft:ageable_grow_up": {
        "remove": { "component_groups": ["pk:baby"] },
        "add": { "component_groups": ["pk:adult"] }
      },
      "pk:on_tame": {
        "remove": { "component_groups": ["pk:wild"] },
        "add": { "component_groups": ["pk:tame"] }
      },
      "pk:plus_on": {
        "add": { "component_groups": ["pk:plus"] }
      },
      "pk:plus_off": {
        "remove": { "component_groups": ["pk:plus"] }
      },
      "pk:charge_up": {
        "remove": { "component_groups": ["pk:plus"] },
        "add": { "component_groups": ["pk:charged"] }
      },
      "pk:discharge": {
        "remove": { "component_groups": ["pk:charged"] }
      },
      "pk:on_captured": {
        "sequence": [
          {
            "filters": { "test": "has_component", "subject": "self", "value": "minecraft:is_tamed" },
            "add": { "component_groups": ["pk:caught"] }
          },
          {
            "filters": {
              "test": "has_component", "subject": "self",
              "operator": "!=", "value": "minecraft:is_tamed"
            },
            "randomize": [
              { "weight": 4, "add": { "component_groups": ["pk:caught"] } },
              { "weight": 1, "trigger": "pk:break_free" }
            ]
          }
        ]
      },
      "pk:break_free": {
        "add": { "component_groups": ["pk:wild"] }
      },
      "minecraft:entity_transformed": {
        "add": { "component_groups": ["pk:adult", "pk:tame"] }
      }
    }
  }
}
