{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pk:pikachu",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pk:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.55 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["sweet_berries", "apple"],
          "grow_up": { "event": "minecraft:ageable_grow_up", "target": "self" }
        }
      },

      "pk:adult": {
        "minecraft:scale": { "value": 1.0 }
      },

      "pk:wild": {
        "minecraft:despawn": { "despawn_from_distance": {} },
        "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.6 },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 3,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 8,
              "walk_speed_multiplier": 1.4,
              "sprint_speed_multiplier": 1.6
            }
          ]
        },
        "minecraft:behavior.tempt": {
          "priority": 5,
          "speed_multiplier": 1.1,
          "items": ["sweet_berries"]
        }
      },

      "pk:tame": {
        "minecraft:is_tamed": {},
        "minecraft:health": { "value": 24, "max": 24 },
        "minecraft:attack": { "damage": 4 },
        "minecraft:sittable": {},
        "minecraft:healable": {
          "filters": { "test": "is_owner", "subject": "other" },
          "items": [
            { "item": "sweet_berries", "heal_amount": 4 },
            { "item": "apple", "heal_amount": 6 }
          ]
        },
        "minecraft:breedable": {
          "require_tame": true,
          "breed_items": ["apple", "golden_apple"],
          "breeds_with": [
            {
              "mate_type": "pk:pikachu",
              "baby_type": "pk:pikachu",
              "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
            }
          ]
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.stay_while_sitting": { "priority": 3 },
        "minecraft:behavior.breed": { "priority": 5, "speed_multiplier": 1.0 },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.3,
          "start_distance": 8,
          "stop_distance": 2
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["pikachu", "mob"] },
      "minecraft:collision_box": { "width": 0.7, "height": 0.95 },
      "minecraft:health": { "value": 16, "max": 16 },
      "minecraft:attack": { "damage": 2 },
      "minecraft:movement": { "value": 0.32 },
      "minecraft:follow_range": { "value": 24, "max": 24 },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": {},
      "minecraft:leashable": { "soft_distance": 4, "hard_distance": 6, "max_distance": 10 },
      "minecraft:loot": { "table": "loot_tables/entities/pikachu.json" },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,4) : 0"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "lightning", "deals_damage": false }
        ]
      },
      "minecraft:tameable": {
        "probability": 0.35,
        "tame_items": ["sweet_berries"],
        "tame_event": { "event": "pk:on_tame", "target": "self" }
      },
      "minecraft:shooter": { "def": "pk:thunder_shock" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 2 },
      "minecraft:behavior.ranged_attack": {
        "priority": 4,
        "attack_interval_min": 1.5,
        "attack_interval_max": 3.0,
        "burst_shots": 1,
        "attack_radius": 12,
        "charge_shoot_trigger": 0
      },
      "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 1.0 },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": { "priority": 10 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          { "add": { "component_groups": ["pk:wild"] } },
          {
            "randomize": [
              { "weight": 90, "add": { "component_groups": ["pk:adult"] } },
              { "weight": 10, "add": { "component_groups": ["pk:baby"] } }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "add": { "component_groups": ["pk:tame", "pk:baby"] }
      },
      "minecraft:ageable_grow_up": {
        "remove": { "component_groups": ["pk:baby"] },
        "add": { "component_groups": ["pk:adult"] }
      },
      "pk:on_tame": {
        "remove": { "component_groups": ["pk:wild"] },
        "add": { "component_groups": ["pk:tame"] }
      }
    }
  }
}
