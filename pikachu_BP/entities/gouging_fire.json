{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pk:gouging_fire",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pk:wild": {
        "minecraft:tameable": {
          "probability": 0.24,
          "tame_items": ["fire_charge"],
          "tame_event": { "event": "pk:on_tame", "target": "self" }
        },
        "minecraft:despawn": {
          "despawn_from_distance": { "max_distance": 128, "min_distance": 96 }
        }
      },

      "pk:tame": {
        "minecraft:is_tamed": {},
        "minecraft:persistent": {},
        "minecraft:health": { "value": 180, "max": 180 },
        "minecraft:attack": { "damage": 13 },
        "minecraft:healable": {
          "filters": { "test": "is_owner", "subject": "other" },
          "items": [
            { "item": "coal", "heal_amount": 10 },
            { "item": "fire_charge", "heal_amount": 35 }
          ]
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "crouching_skip_interact": true,
          "family_types": ["player"],
          "interact_text": "action.interact.ride.horse",
          "seats": { "position": [0, 1.75, 0.1], "lock_rider_rotation": 0 }
        },
        "minecraft:input_ground_controlled": {},
        "minecraft:behavior.player_ride_tamed": { "priority": 1 },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 2 },
        "minecraft:behavior.owner_hurt_target": { "priority": 3 },
        "minecraft:behavior.follow_owner": {
          "priority": 9,
          "speed_multiplier": 1.3,
          "start_distance": 12,
          "stop_distance": 4,
          "can_teleport": true
        }
      },

      "pk:proto": {
        "minecraft:type_family": {
          "family": ["gouging_fire", "paradox", "proto", "mob"]
        },
        "minecraft:movement": { "value": 0.36 },
        "minecraft:knockback_resistance": { "value": 1.0 },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "projectile",
              "deals_damage": false,
              "on_damage": {
                "event": "pk:on_captured",
                "target": "self",
                "filters": {
                  "any_of": [
                    { "test": "is_family", "subject": "damager", "value": "poke_ball" },
                    { "test": "is_family", "subject": "other", "value": "poke_ball" }
                  ]
                }
              }
            },
            {
              "cause": "entity_attack",
              "damage_multiplier": 0.7,
              "on_damage": { "event": "pk:bulwark_up", "target": "self" }
            },
            { "cause": "fire", "deals_damage": false },
            { "cause": "fire_tick", "deals_damage": false },
            { "cause": "lava", "deals_damage": false },
            { "cause": "magma", "deals_damage": false },
            { "cause": "fall", "damage_multiplier": 0.35 },
            { "cause": "freezing", "damage_multiplier": 2 },
            { "cause": "drowning", "damage_multiplier": 2 },
            { "cause": "all", "damage_multiplier": 0.7 }
          ]
        }
      },

      "pk:rampage": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 5,
          "must_see": true,
          "must_see_forget_duration": 8.0,
          "reselect_targets": true,
          "scan_interval": 20,
          "within_radius": 20,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 32
            },
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 16
            }
          ]
        }
      },

      "pk:bulwark": {
        "minecraft:area_attack": {
          "cause": "fire",
          "damage_per_tick": 1,
          "damage_range": 1.0,
          "play_sound": "mob.blaze.breathe",
          "entity_filter": {
            "all_of": [
              {
                "test": "is_family", "subject": "other",
                "operator": "!=", "value": "gouging_fire"
              },
              {
                "test": "is_owner", "subject": "other",
                "operator": "!=", "value": true
              }
            ]
          }
        },
        "minecraft:timer": {
          "looping": false,
          "time": 4.0,
          "time_down_event": { "event": "pk:bulwark_down", "target": "self" }
        }
      },

      "pk:caught": {
        "minecraft:transformation": {
          "into": "pk:caught_gouging_fire",
          "delay": { "value": 0.35 },
          "keep_owner": true,
          "drop_equipment": false,
          "transformation_sound": "beacon.deactivate"
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["gouging_fire", "paradox", "mob"] },
      "minecraft:collision_box": { "width": 1.8, "height": 2.6 },
      "minecraft:health": { "value": 130, "max": 130 },
      "minecraft:attack": { "damage": 9 },
      "minecraft:knockback_resistance": { "value": 0.9 },
      "minecraft:follow_range": { "value": 40, "max": 40 },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 50 : 0"
      },

      "minecraft:movement": { "value": 0.32 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "can_pass_doors": false,
        "avoid_water": true,
        "avoid_damage_blocks": false
      },
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
      "minecraft:conditional_bandwidth_optimization": {},

      "minecraft:fire_immune": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "projectile",
            "deals_damage": false,
            "on_damage": {
              "event": "pk:on_captured",
              "target": "self",
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "damager", "value": "poke_ball" },
                  { "test": "is_family", "subject": "other", "value": "poke_ball" }
                ]
              }
            }
          },
          {
            "cause": "entity_attack",
            "damage_multiplier": 1.0,
            "on_damage": { "event": "pk:bulwark_up", "target": "self" }
          },
          { "cause": "fire", "deals_damage": false },
          { "cause": "fire_tick", "deals_damage": false },
          { "cause": "lava", "deals_damage": false },
          { "cause": "magma", "deals_damage": false },
          { "cause": "fall", "damage_multiplier": 0.5 },
          { "cause": "freezing", "damage_multiplier": 2 },
          { "cause": "drowning", "damage_multiplier": 2 }
        ]
      },

      "minecraft:nameable": {},
      "minecraft:leashable": { "soft_distance": 5, "hard_distance": 8, "max_distance": 12 },
      "minecraft:loot": { "table": "loot_tables/entities/gouging_fire.json" },
      "minecraft:shooter": { "def": "pk:raging_fury" },

      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                { "test": "is_family", "subject": "self", "operator": "!=", "value": "proto" },
                { "test": "is_daytime", "subject": "self", "operator": "==", "value": true },
                { "test": "weather", "operator": "==", "value": "clear" }
              ]
            },
            "event": "pk:proto_on",
            "target": "self"
          },
          {
            "filters": {
              "all_of": [
                { "test": "is_family", "subject": "self", "value": "proto" },
                {
                  "any_of": [
                    { "test": "is_daytime", "subject": "self", "operator": "==", "value": false },
                    { "test": "weather", "operator": "!=", "value": "clear" }
                  ]
                }
              ]
            },
            "event": "pk:proto_off",
            "target": "self"
          }
        ]
      },

      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 5,
        "must_see": true,
        "must_see_forget_duration": 8.0,
        "reselect_targets": true,
        "scan_interval": 20,
        "within_radius": 20,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "monster" },
            "max_dist": 32
          }
        ]
      },
      "minecraft:behavior.delayed_attack": {
        "priority": 6,
        "attack_once": false,
        "track_target": true,
        "require_complete_path": false,
        "random_stop_interval": 0,
        "reach_multiplier": 1.5,
        "speed_multiplier": 1.2,
        "attack_duration": 0.9,
        "hit_delay_pct": 0.45
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 7,
        "attack_interval": { "min": 2.0, "max": 3.5 },
        "attack_range": { "min": 6, "max": 20 },
        "charge_shoot_trigger": 1,
        "burst_interval": 0.25,
        "burst_shots": 3,
        "in_range_movement_mode": "follow_target",
        "set_persistent": true
      },
      "minecraft:behavior.random_stroll": { "priority": 10, "speed_multiplier": 0.6 },
      "minecraft:behavior.look_at_player": {
        "priority": 11,
        "look_distance": 20,
        "probability": 0.08
      },
      "minecraft:behavior.random_look_around": { "priority": 12 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["pk:wild"] }
      },
      "pk:on_tame": {
        "remove": { "component_groups": ["pk:wild", "pk:rampage"] },
        "add": { "component_groups": ["pk:tame"] }
      },
      "pk:proto_on": {
        "sequence": [
          { "add": { "component_groups": ["pk:proto"] } },
          {
            "filters": {
              "test": "has_component", "subject": "self",
              "operator": "!=", "value": "minecraft:is_tamed"
            },
            "add": { "component_groups": ["pk:rampage"] }
          }
        ]
      },
      "pk:proto_off": {
        "remove": { "component_groups": ["pk:proto", "pk:rampage"] }
      },
      "pk:bulwark_up": {
        "add": { "component_groups": ["pk:bulwark"] }
      },
      "pk:bulwark_down": {
        "remove": { "component_groups": ["pk:bulwark"] }
      },
      "pk:on_captured": {
        "sequence": [
          { "add": { "component_groups": ["pk:caught"] } },
          {
            "filters": {
              "test": "has_component", "subject": "self",
              "operator": "!=", "value": "minecraft:is_tamed"
            },
            "randomize": [
              { "weight": 1, "add": { "component_groups": ["pk:caught"] } },
              { "weight": 5, "trigger": "pk:break_free" }
            ]
          }
        ]
      },
      "pk:break_free": {
        "remove": { "component_groups": ["pk:caught"] }
      },
      "minecraft:entity_transformed": {
        "add": { "component_groups": ["pk:tame"] }
      }
    }
  }
}
