{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pk:rayquaza",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pk:wild": {
        "minecraft:tameable": {
          "probability": 0.34,
          "tame_items": ["ancient_debris", "golden_apple"],
          "tame_event": { "event": "pk:on_tame", "target": "self" }
        },
        "minecraft:despawn": {
          "despawn_from_distance": { "max_distance": 128, "min_distance": 96 }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 4,
          "must_see": true,
          "must_see_forget_duration": 8.0,
          "reselect_targets": true,
          "scan_interval": 20,
          "within_radius": 40,
          "target_search_height": 64,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 40
            }
          ]
        }
      },

      "pk:tame": {
        "minecraft:is_tamed": {},
        "minecraft:persistent": {},
        "minecraft:health": { "value": 220, "max": 220 },
        "minecraft:attack": { "damage": 14 },
        "minecraft:flying_speed": { "value": 0.32 },
        "minecraft:healable": {
          "filters": { "test": "is_owner", "subject": "other" },
          "items": [
            { "item": "golden_apple", "heal_amount": 40 },
            { "item": "ancient_debris", "heal_amount": 80 }
          ]
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "crouching_skip_interact": true,
          "family_types": ["player"],
          "interact_text": "action.interact.ride.horse",
          "seats": { "position": [0, 1.35, 0.1], "lock_rider_rotation": 0 }
        },
        "minecraft:input_air_controlled": {},
        "minecraft:behavior.player_ride_tamed": { "priority": 1 },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 2 },
        "minecraft:behavior.owner_hurt_target": { "priority": 3 },
        "minecraft:behavior.follow_owner": {
          "priority": 7,
          "speed_multiplier": 1.4,
          "start_distance": 12,
          "stop_distance": 4,
          "can_teleport": true
        }
      },

      "pk:air_lock": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "event": "pk:calm_the_sky",
              "filters": { "test": "weather", "operator": "!=", "value": "clear" }
            }
          ]
        }
      },

      "pk:air_lock_spent": {
        "minecraft:timer": {
          "looping": false,
          "time": 30,
          "time_down_event": { "event": "pk:air_lock_ready", "target": "self" }
        }
      },
      "pk:caught": {
        "minecraft:transformation": {
          "into": "pk:caught_rayquaza",
          "delay": { "value": 0.35 },
          "keep_owner": true,
          "drop_equipment": false,
          "transformation_sound": "beacon.deactivate"
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["rayquaza", "dragon", "mob"] },
      "minecraft:collision_box": { "width": 1.8, "height": 1.8 },
      "minecraft:health": { "value": 160, "max": 160 },
      "minecraft:attack": { "damage": 10 },
      "minecraft:knockback_resistance": { "value": 0.9 },
      "minecraft:follow_range": { "value": 64, "max": 64 },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 60 : 0"
      },

      "minecraft:movement": { "value": 0.4 },
      "minecraft:flying_speed": { "value": 0.22 },
      "minecraft:movement.fly": {},
      "minecraft:navigation.fly": {
        "can_path_over_water": true,
        "can_path_from_air": true,
        "can_pass_doors": false,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:can_fly": {},
      "minecraft:jump.static": {},
      "minecraft:physics": { "has_gravity": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:conditional_bandwidth_optimization": {},

      "minecraft:fire_immune": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "projectile",
            "deals_damage": false,
            "on_damage": {
              "event": "pk:on_captured",
              "target": "self",
              "filters": { "test": "is_family", "subject": "other", "value": "poke_ball" }
            }
          },
          { "cause": "lightning", "deals_damage": false },
          { "cause": "fall", "deals_damage": false },
          { "cause": "drowning", "deals_damage": false },
          { "cause": "freezing", "deals_damage": false }
        ]
      },

      "minecraft:nameable": {},
      "minecraft:loot": { "table": "loot_tables/entities/rayquaza.json" },
      "minecraft:shooter": { "def": "pk:dragon_pulse" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.ranged_attack": {
        "priority": 5,
        "attack_interval": { "min": 1.5, "max": 3.0 },
        "attack_range": { "min": 4, "max": 32 },
        "charge_shoot_trigger": 1,
        "burst_interval": 0.35,
        "burst_shots": 3,
        "in_range_movement_mode": "follow_target",
        "set_persistent": true
      },
      "minecraft:behavior.random_fly": {
        "priority": 8,
        "xz_dist": 24,
        "y_dist": 12,
        "y_offset": 4,
        "speed_multiplier": 1.0,
        "can_land_on_trees": false,
        "avoid_damage_blocks": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 24,
        "probability": 0.08
      },
      "minecraft:behavior.random_look_around": { "priority": 10 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["pk:wild", "pk:air_lock"] }
      },
      "pk:on_tame": {
        "remove": { "component_groups": ["pk:wild"] },
        "add": { "component_groups": ["pk:tame"] }
      },
      "pk:calm_the_sky": {
        "sequence": [
          { "queue_command": { "command": "weather clear" } },
          {
            "remove": { "component_groups": ["pk:air_lock"] },
            "add": { "component_groups": ["pk:air_lock_spent"] }
          }
        ]
      },
      "pk:air_lock_ready": {
        "remove": { "component_groups": ["pk:air_lock_spent"] },
        "add": { "component_groups": ["pk:air_lock"] }
      },
      "pk:on_captured": {
        "sequence": [
          { "add": { "component_groups": ["pk:caught"] } },
          {
            "filters": {
              "test": "has_component", "subject": "self",
              "operator": "!=", "value": "minecraft:is_tamed"
            },
            "randomize": [
              { "weight": 1, "add": { "component_groups": ["pk:caught"] } },
              { "weight": 4, "trigger": "pk:break_free" }
            ]
          }
        ]
      },
      "pk:break_free": {
        "remove": { "component_groups": ["pk:caught"] }
      },
      "minecraft:entity_transformed": {
        "add": { "component_groups": ["pk:tame", "pk:air_lock"] }
      }
    }
  }
}
