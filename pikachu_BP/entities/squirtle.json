{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pk:squirtle",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pk:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.55 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["cod", "salmon"],
          "grow_up": { "event": "minecraft:ageable_grow_up", "target": "self" }
        }
      },

      "pk:adult": {
        "minecraft:scale": { "value": 1.0 }
      },

      "pk:wild": {
        "minecraft:despawn": { "despawn_from_distance": {} },
        "minecraft:behavior.panic": {
          "priority": 1,
          "speed_multiplier": 1.4,
          "prefer_water": true
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 3,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 8,
              "walk_speed_multiplier": 1.3,
              "sprint_speed_multiplier": 1.5
            }
          ]
        },
        "minecraft:behavior.tempt": {
          "priority": 5,
          "speed_multiplier": 1.1,
          "can_tempt_vertically": true,
          "items": ["cod"]
        },
        "minecraft:behavior.move_to_water": {
          "priority": 6,
          "search_range": 16,
          "search_height": 5,
          "goal_radius": 1.5
        }
      },

      "pk:tame": {
        "minecraft:is_tamed": {},
        "minecraft:health": { "value": 30, "max": 30 },
        "minecraft:attack": { "damage": 5 },
        "minecraft:sittable": {},
        "minecraft:healable": {
          "filters": { "test": "is_owner", "subject": "other" },
          "items": [
            { "item": "cod", "heal_amount": 4 },
            { "item": "salmon", "heal_amount": 6 }
          ]
        },
        "minecraft:breedable": {
          "require_tame": true,
          "breed_items": ["salmon", "tropical_fish"],
          "breeds_with": [
            {
              "mate_type": "pk:squirtle",
              "baby_type": "pk:squirtle",
              "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
            }
          ]
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  { "test": "actor_health", "subject": "self", "operator": "<=", "value": 10 },
                  { "test": "is_family", "subject": "self", "operator": "!=", "value": "torrent" }
                ]
              },
              "event": "pk:torrent_on",
              "target": "self"
            },
            {
              "filters": {
                "all_of": [
                  { "test": "actor_health", "subject": "self", "operator": ">", "value": 10 },
                  { "test": "is_family", "subject": "self", "value": "torrent" }
                ]
              },
              "event": "pk:torrent_off",
              "target": "self"
            }
          ]
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.stay_while_sitting": { "priority": 3 },
        "minecraft:behavior.breed": { "priority": 5, "speed_multiplier": 1.0 },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.3,
          "start_distance": 8,
          "stop_distance": 2,
          "can_teleport": true
        }
      },

      "pk:torrent": {
        "minecraft:type_family": { "family": ["squirtle", "torrent", "mob"] },
        "minecraft:shooter": { "def": "pk:water_gun_torrent" }
      },

      "pk:caught": {
        "minecraft:transformation": {
          "into": "pk:caught_squirtle",
          "delay": { "value": 0.35 },
          "keep_owner": true,
          "drop_equipment": false,
          "transformation_sound": "beacon.deactivate"
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["squirtle", "mob"] },
      "minecraft:collision_box": { "width": 0.8, "height": 1.0 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:attack": { "damage": 3 },
      "minecraft:movement": { "value": 0.24 },
      "minecraft:underwater_movement": { "value": 0.28 },
      "minecraft:water_movement": { "drag_factor": 0.85 },
      "minecraft:follow_range": { "value": 24, "max": 24 },
      "minecraft:knockback_resistance": { "value": 0.5 },
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_path_over_water": true,
        "can_swim": true,
        "can_walk": true,
        "can_sink": false,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.amphibious": { "max_turn": 15 },
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true,
        "breathes_air": true,
        "generates_bubbles": false
      },
      "minecraft:nameable": {},
      "minecraft:leashable": { "soft_distance": 4, "hard_distance": 6, "max_distance": 10 },
      "minecraft:loot": { "table": "loot_tables/entities/squirtle.json" },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,4) : 0"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "lightning", "damage_multiplier": 2.0 },
          { "cause": "fire", "damage_multiplier": 0.5 },
          { "cause": "fire_tick", "damage_multiplier": 0.5 },
          { "cause": "lava", "damage_multiplier": 0.5 },
          { "cause": "fall", "damage_multiplier": 0.5 }
        ]
      },
      "minecraft:tameable": {
        "probability": 0.3,
        "tame_items": ["cod"],
        "tame_event": { "event": "pk:on_tame", "target": "self" }
      },
      "minecraft:shooter": { "def": "pk:water_gun" },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                { "test": "actor_health", "subject": "self", "operator": "<=", "value": 7 },
                { "test": "is_family", "subject": "self", "operator": "!=", "value": "torrent" }
              ]
            },
            "event": "pk:torrent_on",
            "target": "self"
          },
          {
            "filters": {
              "all_of": [
                { "test": "actor_health", "subject": "self", "operator": ">", "value": 7 },
                { "test": "is_family", "subject": "self", "value": "torrent" }
              ]
            },
            "event": "pk:torrent_off",
            "target": "self"
          }
        ]
      },
      "minecraft:behavior.hurt_by_target": { "priority": 2 },
      "minecraft:behavior.ranged_attack": {
        "priority": 4,
        "attack_interval_min": 1.4,
        "attack_interval_max": 2.6,
        "burst_shots": 1,
        "attack_radius": 13,
        "attack_radius_min": 3,
        "charge_shoot_trigger": 0
      },
      "minecraft:behavior.melee_attack": {
        "priority": 7,
        "speed_multiplier": 1.2,
        "track_target": true,
        "reach_multiplier": 1.4
      },
      "minecraft:behavior.random_swim": {
        "priority": 8,
        "interval": 0,
        "xz_dist": 20,
        "y_dist": 8
      },
      "minecraft:behavior.random_stroll": { "priority": 9, "speed_multiplier": 1.0 },
      "minecraft:behavior.look_at_player": {
        "priority": 10,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": { "priority": 11 },
      "minecraft:conditional_bandwidth_optimization": {}
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          { "add": { "component_groups": ["pk:wild"] } },
          {
            "randomize": [
              { "weight": 90, "add": { "component_groups": ["pk:adult"] } },
              { "weight": 10, "add": { "component_groups": ["pk:baby"] } }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "add": { "component_groups": ["pk:tame", "pk:baby"] }
      },
      "minecraft:ageable_grow_up": {
        "remove": { "component_groups": ["pk:baby"] },
        "add": { "component_groups": ["pk:adult"] }
      },
      "pk:on_tame": {
        "remove": { "component_groups": ["pk:wild"] },
        "add": { "component_groups": ["pk:tame"] }
      },
      "pk:torrent_on": {
        "add": { "component_groups": ["pk:torrent"] }
      },
      "pk:torrent_off": {
        "remove": { "component_groups": ["pk:torrent"] }
      },
      "pk:on_captured": {
        "sequence": [
          {
            "filters": { "test": "has_component", "subject": "self", "value": "minecraft:is_tamed" },
            "add": { "component_groups": ["pk:caught"] }
          },
          {
            "filters": {
              "test": "has_component", "subject": "self",
              "operator": "!=", "value": "minecraft:is_tamed"
            },
            "randomize": [
              { "weight": 3, "add": { "component_groups": ["pk:caught"] } },
              { "weight": 2, "trigger": "pk:break_free" }
            ]
          }
        ]
      },
      "pk:break_free": {
        "add": { "component_groups": ["pk:wild"] }
      },
      "minecraft:entity_transformed": {
        "add": { "component_groups": ["pk:adult", "pk:tame"] }
      }
    }
  }
}
