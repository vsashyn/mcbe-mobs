{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pk:moltres",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pk:wild": {
        "minecraft:tameable": {
          "probability": 0.28,
          "tame_items": ["blaze_rod", "magma_cream"],
          "tame_event": { "event": "pk:on_tame", "target": "self" }
        },
        "minecraft:despawn": {
          "despawn_from_distance": { "max_distance": 128, "min_distance": 96 }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 4,
          "must_see": true,
          "must_see_forget_duration": 6.0,
          "reselect_targets": true,
          "scan_interval": 20,
          "within_radius": 20,
          "target_search_height": 48,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 32
            },
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 20
            }
          ]
        }
      },

      "pk:tame": {
        "minecraft:is_tamed": {},
        "minecraft:persistent": {},
        "minecraft:health": { "value": 170, "max": 170 },
        "minecraft:attack": { "damage": 11, "effect_name": "wither", "effect_duration": 3 },
        "minecraft:flying_speed": { "value": 0.34 },
        "minecraft:healable": {
          "filters": { "test": "is_owner", "subject": "other" },
          "items": [
            { "item": "magma_cream", "heal_amount": 20 },
            { "item": "blaze_rod", "heal_amount": 45 }
          ]
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "crouching_skip_interact": true,
          "family_types": ["player"],
          "interact_text": "action.interact.ride.horse",
          "seats": { "position": [0, 1.5, 0.2], "lock_rider_rotation": 0 }
        },
        "minecraft:input_air_controlled": {},
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  { "test": "actor_health", "subject": "self", "operator": "<=", "value": 85 },
                  { "test": "is_family", "subject": "self", "operator": "!=", "value": "berserk" }
                ]
              },
              "event": "pk:berserk_on",
              "target": "self"
            },
            {
              "filters": {
                "all_of": [
                  { "test": "actor_health", "subject": "self", "operator": ">", "value": 85 },
                  { "test": "is_family", "subject": "self", "value": "berserk" }
                ]
              },
              "event": "pk:berserk_off",
              "target": "self"
            }
          ]
        },
        "minecraft:behavior.player_ride_tamed": { "priority": 1 },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 2 },
        "minecraft:behavior.owner_hurt_target": { "priority": 3 },
        "minecraft:behavior.follow_owner": {
          "priority": 7,
          "speed_multiplier": 1.4,
          "start_distance": 12,
          "stop_distance": 4,
          "can_teleport": true
        }
      },

      "pk:berserk": {
        "minecraft:type_family": { "family": ["moltres", "bird", "berserk", "mob"] },
        "minecraft:attack": { "damage": 12, "effect_name": "wither", "effect_duration": 4 },
        "minecraft:flying_speed": { "value": 0.34 },
        "minecraft:behavior.ranged_attack": {
          "priority": 5,
          "attack_interval": { "min": 0.9, "max": 1.8 },
          "attack_range": { "min": 3, "max": 28 },
          "charge_shoot_trigger": 1,
          "burst_interval": 0.2,
          "burst_shots": 4,
          "in_range_movement_mode": "follow_target",
          "set_persistent": true
        }
      },

      "pk:caught": {
        "minecraft:transformation": {
          "into": "pk:caught_moltres",
          "delay": { "value": 0.35 },
          "keep_owner": true,
          "drop_equipment": false,
          "transformation_sound": "beacon.deactivate"
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["moltres", "bird", "mob"] },
      "minecraft:collision_box": { "width": 1.6, "height": 1.6 },
      "minecraft:health": { "value": 120, "max": 120 },
      "minecraft:attack": { "damage": 8, "effect_name": "wither", "effect_duration": 3 },
      "minecraft:knockback_resistance": { "value": 0.7 },
      "minecraft:follow_range": { "value": 48, "max": 48 },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 45 : 0"
      },

      "minecraft:movement": { "value": 0.38 },
      "minecraft:flying_speed": { "value": 0.26 },
      "minecraft:movement.fly": {},
      "minecraft:navigation.fly": {
        "can_path_over_water": true,
        "can_path_from_air": true,
        "can_pass_doors": false,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:can_fly": {},
      "minecraft:jump.static": {},
      "minecraft:physics": { "has_gravity": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:conditional_bandwidth_optimization": {},

      "minecraft:fire_immune": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "projectile",
            "deals_damage": false,
            "on_damage": {
              "event": "pk:on_captured",
              "target": "self",
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "damager", "value": "poke_ball" },
                  { "test": "is_family", "subject": "other", "value": "poke_ball" }
                ]
              }
            }
          },
          { "cause": "fall", "deals_damage": false },
          { "cause": "drowning", "deals_damage": false },
          { "cause": "freezing", "deals_damage": false }
        ]
      },

      "minecraft:nameable": {},
      "minecraft:loot": { "table": "loot_tables/entities/moltres.json" },
      "minecraft:shooter": { "def": "pk:fiery_wrath" },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                { "test": "actor_health", "subject": "self", "operator": "<=", "value": 60 },
                { "test": "is_family", "subject": "self", "operator": "!=", "value": "berserk" }
              ]
            },
            "event": "pk:berserk_on",
            "target": "self"
          },
          {
            "filters": {
              "all_of": [
                { "test": "actor_health", "subject": "self", "operator": ">", "value": 60 },
                { "test": "is_family", "subject": "self", "value": "berserk" }
              ]
            },
            "event": "pk:berserk_off",
            "target": "self"
          }
        ]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.ranged_attack": {
        "priority": 5,
        "attack_interval": { "min": 1.4, "max": 2.8 },
        "attack_range": { "min": 4, "max": 24 },
        "charge_shoot_trigger": 1,
        "burst_interval": 0.25,
        "burst_shots": 3,
        "in_range_movement_mode": "follow_target",
        "set_persistent": true
      },
      "minecraft:behavior.random_fly": {
        "priority": 8,
        "xz_dist": 20,
        "y_dist": 10,
        "y_offset": 3,
        "speed_multiplier": 1.0,
        "can_land_on_trees": false,
        "avoid_damage_blocks": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 24,
        "probability": 0.1
      },
      "minecraft:behavior.random_look_around": { "priority": 10 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["pk:wild"] }
      },
      "pk:on_tame": {
        "remove": { "component_groups": ["pk:wild", "pk:berserk"] },
        "add": { "component_groups": ["pk:tame"] }
      },
      "pk:berserk_on": {
        "add": { "component_groups": ["pk:berserk"] }
      },
      "pk:berserk_off": {
        "remove": { "component_groups": ["pk:berserk"] }
      },
      "pk:on_captured": {
        "sequence": [
          { "add": { "component_groups": ["pk:caught"] } },
          {
            "filters": {
              "test": "has_component", "subject": "self",
              "operator": "!=", "value": "minecraft:is_tamed"
            },
            "randomize": [
              { "weight": 1, "add": { "component_groups": ["pk:caught"] } },
              { "weight": 4, "trigger": "pk:break_free" }
            ]
          }
        ]
      },
      "pk:break_free": {
        "remove": { "component_groups": ["pk:caught"] }
      },
      "minecraft:entity_transformed": {
        "add": { "component_groups": ["pk:tame"] }
      }
    }
  }
}
