    "animation.poke_ball.rest": {
      "loop": true,
      "bones": {
        "body": {
          "position": [0, "4.0 + math.sin(query.life_time * 120) * 0.35 + 0.35", 0],
          "rotation": [0, "query.life_time * 25", 0]
        }
      }
    }
  }
}
