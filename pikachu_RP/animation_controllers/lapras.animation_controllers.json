{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.lapras.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "blend_transition": 0.5,
          "transitions": [
            { "resting": "query.is_sitting" },
            { "swimming": "query.is_in_water" },
            { "walking": "query.modified_move_speed > 0.05" }
          ]
        },
        "walking": {
          "animations": ["walk"],
          "blend_transition": 0.5,
          "transitions": [
            { "resting": "query.is_sitting" },
            { "swimming": "query.is_in_water" },
            { "idle": "query.modified_move_speed <= 0.05" }
          ]
        },
        "swimming": {
          "animations": ["swim"],
          "blend_transition": 0.6,
          "transitions": [
            { "resting": "query.is_sitting" },
            { "idle": "!query.is_in_water" }
          ]
        },
        "resting": {
          "animations": ["sit"],
          "blend_transition": 0.6,
          "transitions": [
            { "idle": "!query.is_sitting" }
          ]
        }
      }
    }
  }
}
