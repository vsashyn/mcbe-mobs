{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minun.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "blend_transition": 0.3,
          "transitions": [
            { "sitting": "query.is_sitting" },
            { "walking": "query.modified_move_speed > 0.05" },
            { "cheering": "math.mod(query.life_time, 9.0) < 1.2" }
          ]
        },
        "walking": {
          "animations": ["walk"],
          "blend_transition": 0.3,
          "transitions": [
            { "sitting": "query.is_sitting" },
            { "idle": "query.modified_move_speed <= 0.05" }
          ]
        },
        "cheering": {
          "animations": ["cheer"],
          "blend_transition": 0.25,
          "transitions": [
            { "sitting": "query.is_sitting" },
            { "walking": "query.modified_move_speed > 0.05" },
            { "idle": "math.mod(query.life_time, 9.0) >= 1.2" }
          ]
        },
        "sitting": {
          "animations": ["sit"],
          "blend_transition": 0.35,
          "transitions": [
            { "idle": "!query.is_sitting" }
          ]
        }
      }
    }
  }
}
