{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.moltres.move": {
      "initial_state": "hover",
      "states": {
        "hover": {
          "animations": ["hover"],
          "blend_transition": 0.5,
          "transitions": [
            { "hunt": "query.has_target" },
            { "glide": "query.modified_move_speed > 0.05" }
          ]
        },
        "glide": {
          "animations": ["glide"],
          "blend_transition": 0.5,
          "transitions": [
            { "hunt": "query.has_target" },
            { "hover": "query.modified_move_speed <= 0.05" }
          ]
        },
        "hunt": {
          "animations": ["hunt"],
          "blend_transition": 0.35,
          "transitions": [
            { "glide": "!query.has_target && query.modified_move_speed > 0.05" },
            { "hover": "!query.has_target" }
          ]
        }
      }
    }
  }
}
