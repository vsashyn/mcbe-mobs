{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.gouging_fire.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "blend_transition": 0.35,
          "transitions": [
            { "roaring": "query.is_delayed_attacking" },
            { "walking": "query.modified_move_speed > 0.05" }
          ]
        },
        "walking": {
          "animations": ["walk"],
          "blend_transition": 0.35,
          "transitions": [
            { "roaring": "query.is_delayed_attacking" },
            { "idle": "query.modified_move_speed <= 0.05" }
          ]
        },
        "roaring": {
          "animations": ["roar"],
          "blend_transition": 0.15,
          "transitions": [
            { "walking": "!query.is_delayed_attacking && query.modified_move_speed > 0.05" },
            { "idle": "!query.is_delayed_attacking" }
          ]
        }
      }
    }
  }
}
